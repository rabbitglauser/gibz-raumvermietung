APP_NAME=room-rental-api
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB=room_rental
CORS_ORIGINS=http://localhost:3000

# Customer edit window / reminder automation
EDIT_DEADLINE_DAYS=3
REMINDER_WINDOW_DAYS=5
REMINDER_INTERVAL_MINUTES=60
REMINDERS_ENABLED=false

# Staff auth — set a strong random JWT_SECRET in production
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=480
AUTH_COOKIE_SECURE=false

# SMTP for reminder emails (MailHog defaults). Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=1025
SMTP_FROM=raumvermietung@gibz.ch

# Used to build customer edit links inside reminder emails
PUBLIC_BASE_URL=http://localhost:3000
EDIT_DEADLINE_HOURS=24
PUBLIC_FRONTEND_URL=http://localhost:3000
AUTH_SECRET_KEY=change-this-secret-for-local-demo
AUTH_TOKEN_MINUTES=480
AUTH_COOKIE_NAME=staff_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
SEED_STAFF_ENABLED=true
SEED_STAFF_USERNAME=secretariat
SEED_STAFF_PASSWORD=ChangeMe123!
SEED_STAFF_NAME=Demo Secretariat
SEED_STAFF_EMAIL=secretariat@example.com
REMINDER_DAYS_BEFORE=7
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
